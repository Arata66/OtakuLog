{
  "name": "otakulog-desktop",
  "version": "1.1.0-beta.1",
  "private": true,
  "description": "OtakuLog Windows 本地桌面应用",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src scripts test e2e --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "dev": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable nsis zip --x64 --publish never",
    "test:e2e": "npm run build && node --test --test-concurrency=1 e2e/*.test.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
